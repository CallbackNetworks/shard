# ---------- builder ----------
FROM python:3.11-slim AS builder

WORKDIR /app

# uv, pinned by digest. `:latest` here was the one floating tag in the whole build,
# and it sat on the layer that installs every dependency — the thing most worth being
# able to reproduce. The 0.12.6 tag is for humans; the digest is what actually holds.
COPY --from=ghcr.io/astral-sh/uv:0.12.6@sha256:88bc6eb1ccd4b82efd0e1b530caffabddf50dc2bf612e66c14ea25b8ee8a4d3d /uv /usr/local/bin/uv

COPY requirements.txt requirements.lock ./
RUN uv venv .venv && uv pip install -r requirements.lock

# ---------- runtime ----------
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY . .

# Non-root. The production image has no bind mount, so the uid is free — but the
# deploy host binds ./data in, and 1000 is what the generated compose runs against.
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} app 2>/dev/null || true \
 && useradd -u ${APP_UID} -g ${APP_GID} -m -s /usr/sbin/nologin app 2>/dev/null || true \
 && mkdir -p /app/data /app/uploads \
 && chown -R ${APP_UID}:${APP_GID} /app

ENV PATH="/app/.venv/bin:$PATH"

USER app

EXPOSE 8000

# --workers 1, deliberately (ADR-0101): this is a single-user personal tool, so the
# concurrency win from a second worker is marginal, and staying at 1 makes the
# in-memory rate limiters in services/rate_limiter.py fully authoritative — no more
# "get up to 2x the intended quota by luck of which worker answers your request."
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
