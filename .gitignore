# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.db
*.db-shm
*.db-wal

# Node
node_modules/
core.*

# Build artifacts
frontend/dist/

# Coverage
.coverage
backend/.coverage

# Data. The directories themselves are tracked (via .gitkeep) and only their
# contents are ignored: they are bind-mount targets, and a path Compose has to
# create is created by the daemon as root, which the container — uid 1000 — then
# cannot write to. A fresh clone that has them already owns them. See ADR-0138.
data/*
!data/.gitkeep

# Editor
.DS_Store
*.swp
.env
backend/uploads/
/uploads/*
!/uploads/.gitkeep

# Crash artifacts. Node OOMs on this host have left multi-GB core dumps in
# frontend/ more than once (2.2GB and 4.3GB at last count), and nothing was
# stopping them being committed.
core
core.*

# Secrets that are not the single .env above — a .env.production or .env.local
# would otherwise be tracked.
.env.*
!.env.example
*.pem
*.key
*.p12

# Test tooling output
.ruff_cache/
.pytest_cache/
playwright-report/
test-results/
