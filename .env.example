# Shard configuration — copy to .env and adjust. .env is gitignored and is the
# single source of truth for docker-compose. All values here are safe defaults.

# ── Ports ────────────────────────────────────────────────────────────────
# Host ports. BACKEND_PORT/FRONTEND_DEV_PORT apply to the dev stack;
# FRONTEND_PORT is the production nginx port (docker-compose.prod.yml).
BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
FRONTEND_PORT=80
# Vite's proxy target inside the Docker network. Only change if the backend
# service is renamed or moved off the compose network.
BACKEND_URL=http://backend:8000

# ── Database ─────────────────────────────────────────────────────────────
# sqlite (default) | postgresql+psycopg | mysql+pymysql
DATABASE_URL=sqlite:////app/data/shard.db
# Pooling (PostgreSQL/MySQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# SSL mode for cloud PostgreSQL, e.g. require
DB_SSL_MODE=

# ── Security ─────────────────────────────────────────────────────────────
# Built-in shared-password gate for /app. Leave empty for no auth. Works
# standalone with no external dependency.
AUTH_PASSWORD=
# Session token lifetime in seconds (default 7 days). Applies to AUTH_PASSWORD logins.
AUTH_TOKEN_TTL=604800
# Login brute-force throttle: after AUTH_MAX_ATTEMPTS failures from one client IP
# within AUTH_LOCKOUT_SECONDS, further attempts are rejected until the window clears.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
# Forward-auth / trusted-proxy mode. When set, the app trusts this request header
# to carry an already-authenticated identity, delegating login to an upstream SSO
# proxy (Cloudflare Access, oauth2-proxy, Authelia, Authentik, ...). Examples:
#   Cf-Access-Authenticated-User-Email   (Cloudflare Access)
#   X-Auth-Request-Email                 (oauth2-proxy)
#   Remote-User                          (Authelia / Authentik)
# ONLY SAFE when the origin is reachable exclusively through that proxy — anyone
# who can reach the origin directly can forge this header. See docs/adr/0030.
AUTH_PROXY_HEADER=
# Secret for signing share-PIN session cookies. MUST be set in production:
# generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
# If empty, an ephemeral per-process secret is used (PIN sessions reset on restart).
SECRET_KEY=
# Comma-separated allowed CORS origins. Set to your deployed frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Email (optional) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true
# Hour (UTC) to send the daily summary email
SUMMARY_HOUR=8
# Day of week for the weekly digest (0=Mon ... 6=Sun); sent at SUMMARY_HOUR
DIGEST_DAY=1

# ── LLM assistant (optional) ─────────────────────────────────────────────
# claude | openai | stub
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=

# ── Agent context ────────────────────────────────────────────────────────
AGENT_CONTEXT_INSTRUCTIONS=

# ── Backups (runtime-adjustable) ─────────────────────────────────────────
BACKUP_ENABLED=1
BACKUP_HOUR=3
BACKUP_KEEP=7
BACKUP_DIR=/app/data/backups

# ── Remote MCP, served by the backend process (ADR-0080) ─────────────────
# The switch: set it and the backend serves /mcp, leave it empty and the route
# does not exist. Anyone holding it can call every tool.
MCP_HTTP_TOKEN=
# What those tools act with against /api/v1 (ADR-0005). Its scope bounds the
# endpoint, so give it `read,write` — not admin.
MCP_API_KEY=
# Where the tools send their calls: this same process.
MCP_API_BASE_URL=http://localhost:8000
# Standalone entry point only (`python -m app.mcp_server.server`).
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8001

# ── Bundled databases (started with the `postgres` / `mysql` profiles) ────
# Credentials for the compose-managed database containers. DATABASE_URL above
# must be pointed at them explicitly; these values only configure the container.
POSTGRES_DB=shard
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_dev
POSTGRES_PORT=5432
MYSQL_DATABASE=shard
MYSQL_USER=todo
MYSQL_PASSWORD=todo_dev
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_PORT=3306

# ── E2E suite (started with the `e2e` profile) ───────────────────────────
# API key the e2e container authenticates with; create one in the app first.
API_KEY=
# Dev stack: the vite server on :5173. CI overrides this to the prod nginx
# image (http://frontend-prod:80) — see docker-compose.ci.yml.
E2E_BASE_URL=http://frontend:5173
E2E_API_URL=http://backend:8000
# Extra Host headers the vite dev server accepts (comma-separated). Defaults to
# `frontend` so the e2e container can reach it over the Docker network.
VITE_ALLOWED_HOSTS=frontend
